/* CTRLZ Barbershop - Light Theme */

QMainWindow {
    background-color: #FAF7F2;
}

QDialog, QMessageBox {
    background-color: #FAF7F2;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #1E1E2E;
}

QMessageBox QLabel {
    color: #1E1E2E;
}

/* Titles and Headers */
QLabel#titleLabel {
    font-size: 28px;
    font-weight: bold;
    color: #1E1E2E;
    letter-spacing: 1px;
}

QLabel#subtitleLabel {
    font-size: 16px;
    color: #6B7280;
}

QLabel#stepLabel {
    font-size: 14px;
    color: #9CA3AF;
    font-weight: bold;
    text-transform: uppercase;
}

/* Inputs */
QLineEdit, QComboBox, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E2D8CD;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 15px;
    color: #1E1E2E;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #C8956C;
    background-color: #FFFBF5;
}

/* Buttons */
QPushButton {
    background-color: #2D3748;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3A465C;
}

QPushButton:pressed {
    background-color: #1E2532;
}

QPushButton:checked {
    background-color: #C8956C;
    color: #FFFFFF;
    border: 2px solid #C8956C;
}

QPushButton:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

/* Secondary Button (Back, Cancel) */
QPushButton[cssClass="btnSecondary"], QPushButton#btnBack {
    background-color: transparent;
    color: #6B7280;
    border: 1px solid #E2D8CD;
}

QPushButton[cssClass="btnSecondary"]:hover, QPushButton#btnBack:hover {
    background-color: #F5F0EB;
    color: #1E1E2E;
}

/* Action Button (Primary) */
QPushButton[cssClass="btnAction"] {
    background-color: #C8956C;
    color: #FFFFFF;
}

QPushButton[cssClass="btnAction"]:hover {
    background-color: #D6A47C;
}

/* Cards (Barber, Cuts) */
QWidget.CardWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2D8CD;
    border-radius: 12px;
}

QWidget.CardWidget:hover {
    border: 1px solid #C8956C;
    background-color: #FFFBF5;
}

QWidget[selected="true"] {
    border: 2px solid #C8956C;
    background-color: #FFFBF5;
}

QLabel.CardTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1E1E2E;
}

QLabel.CardSubtitle {
    font-size: 14px;
    color: #6B7280;
}

QLabel.CardPrice {
    font-size: 16px;
    font-weight: bold;
    color: #C8956C;
}

/* Calendar - Modern Clean Style */
QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2D8CD;
    border-radius: 12px;
}

QCalendarWidget QWidget {
    alternate-background-color: transparent;
}

/* Calendar Navigation Bar (Month/Year header) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #2D3748;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 6px;
    min-height: 40px;
}

/* Month/Year Label */
QCalendarWidget QToolButton {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
}

QCalendarWidget QToolButton:hover {
    background-color: #3A465C;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* Prev/Next Month Buttons */
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    border-radius: 6px;
    padding: 4px 8px;
    min-width: 30px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background-color: #C8956C;
}

/* Day Headers (Lun, Mar, etc.) */
QCalendarWidget QWidget#qt_calendar_calendarview QHeaderView {
    background-color: #FAF7F2;
}

QCalendarWidget QHeaderView::section {
    background-color: #FAF7F2;
    color: #6B7280;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding: 6px 0px;
}

/* Day Cells */
QCalendarWidget QAbstractItemView:enabled {
    color: #1E1E2E;
    background-color: #FFFFFF;
    selection-background-color: #C8956C;
    selection-color: #FFFFFF;
    font-size: 13px;
    outline: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #D1D5DB;
}

/* Month Dropdown */
QCalendarWidget QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2D8CD;
    border-radius: 8px;
    padding: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #C8956C;
    color: #FFFFFF;
    border-radius: 4px;
}

/* Year Spinbox */
QCalendarWidget QSpinBox {
    background-color: #3A465C;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 14px;
    font-weight: bold;
}

QCalendarWidget QSpinBox::up-button, 
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background-color: transparent;
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ===== ADMIN PANEL STYLES ===== */

/* Admin Tab Buttons */
QPushButton#btnTabCitas, QPushButton#btnTabGestion {
    background-color: transparent;
    color: #6B7280;
    border: 1px solid #E2D8CD;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#btnTabCitas:hover, QPushButton#btnTabGestion:hover {
    background-color: #F5F0EB;
    color: #1E1E2E;
}

QPushButton#btnTabCitas:checked, QPushButton#btnTabGestion:checked {
    background-color: #C8956C;
    color: #FFFFFF;
    border: 2px solid #C8956C;
}

/* Admin Section Titles */
QLabel#lblBarberosTitle, QLabel#lblCortesTitle {
    font-size: 20px;
    font-weight: bold;
    color: #1E1E2E;
    padding: 4px 0px;
}

/* Admin Confirm Button (Green) */
QPushButton[cssClass="btnConfirm"] {
    background-color: #10B981;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton[cssClass="btnConfirm"]:hover {
    background-color: #059669;
}

/* Admin Cancel/Reject Button (Red) */
QPushButton[cssClass="btnCancel"] {
    background-color: #EF4444;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton[cssClass="btnCancel"]:hover {
    background-color: #DC2626;
}

/* Admin Delete Button */
QPushButton[cssClass="btnDelete"] {
    background-color: transparent;
    color: #EF4444;
    border: 1px solid #EF4444;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton[cssClass="btnDelete"]:hover {
    background-color: #FEF2F2;
}

/* Admin Cita Card */
QFrame[cssClass="AdminCitaCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2D8CD;
    border-radius: 10px;
    padding: 8px;
}

QFrame[cssClass="AdminCitaCard"]:hover {
    border: 1px solid #C8956C;
    background-color: #FFFBF5;
}

/* Admin Item Card (barbero/corte list) */
QFrame[cssClass="AdminItemCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2D8CD;
    border-radius: 8px;
    padding: 6px;
}

QFrame[cssClass="AdminItemCard"]:hover {
    border: 1px solid #C8956C;
}

/* Status Labels */
QLabel[cssClass="statusPendiente"] {
    color: #C8956C;
    font-weight: bold;
}

QLabel[cssClass="statusConfirmada"] {
    color: #10B981;
    font-weight: bold;
}

QLabel[cssClass="statusCancelada"] {
    color: #EF4444;
    font-weight: bold;
}
